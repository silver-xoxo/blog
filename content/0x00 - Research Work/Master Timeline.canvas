		{"id":"3e19636a947e8176","type":"text","text":"# 1900","x":60,"y":236,"width":250,"height":60},
		{"id":"91079e299d752f3b","type":"text","text":"George Boole Proved that human logic can be reduced to algebra using only two values : \n- True [1]\n- False [0]","x":833,"y":-30,"width":360,"height":190},
		{"id":"6d8bb76d958a6968","type":"text","text":"According to me, everything began with the discovery of the fact that we can create waves in electricity - which led to creation of telephones, These telephones led to spread of telephone wires everywhere  ","x":-440,"y":-251,"width":360,"height":202},
		{"id":"32faddcf96bad43f","type":"text","text":"# 1937 - 1945","x":45,"y":760,"width":280,"height":60},
		{"id":"0b94e4f90670f5cd","type":"text","text":"Also moved to Vacuum tubes instead of Relays. ","x":833,"y":703,"width":360,"height":175},
		{"id":"1ed88d074005922c","type":"text","text":"# 1947","x":60,"y":1040,"width":250,"height":60},
		{"id":"5fce4bb9b735cbab","type":"text","text":"Discovery of computers and Calculators","x":460,"y":755,"width":280,"height":70},
		{"id":"b190a962f087f4c0","type":"text","text":"Invention of Transistor","x":460,"y":1035,"width":280,"height":70},
		{"id":"c5ca73449c0a454a","type":"text","text":"a solid-state semiconductor switch with no glass tube or heated filament","x":833,"y":1015,"width":360,"height":110},
